# =====================================================================
# PragmaAI – contoh variabel lingkungan
#
# Cara pakai di komputer Anda:
#   1. Salin file ini menjadi .env.local   (Copy-Item .env.example .env.local)
#   2. Isi nilainya dengan data dari Supabase dan penyedia AI.
#   3. Jalankan ulang: npm run dev
#
# File .env.local TIDAK akan ter-upload ke GitHub (sudah ada di .gitignore).
# File .env.example ini JANGAN pernah diisi nilai asli.
# =====================================================================

# ---------- FRONTEND (boleh terlihat di browser) ----------
# Supabase > Connect, atau Project Settings > API Keys
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) atau anon key lama (eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ---------- BACKEND (RAHASIA, hanya dipakai folder api/) ----------
# JANGAN PERNAH diawali VITE_ supaya tidak bocor ke browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Secret key (sb_secret_...) atau service_role key lama (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# ---------- PENYEDIA AI ----------
# Pilih salah satu: openrouter atau openai
AI_PROVIDER=openrouter

# Pilihan A – OpenRouter (bisa gratis). openrouter.ai > Keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Penalaran model: none (paling cepat), low, medium, high
OPENROUTER_REASONING_EFFORT=none

# Pilihan B – OpenAI (berbayar). platform.openai.com > API keys
# Isi bagian ini dan ubah AI_PROVIDER=openai jika ingin memakai OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low

# ---------- PENGATURAN ANALISIS (opsional) ----------
# Batas jumlah analisis per pengguna per 24 jam (admin tidak dibatasi).
ANALYSIS_DAILY_LIMIT=20
# Batas unit tuturan per analisis. Kosongkan untuk otomatis:
# 40 untuk model gratis (":free"), 120 untuk model berbayar.
ANALYSIS_MAX_UTTERANCES=
